# Keep on the Borderlands — Compose runtime configuration (game-deployment).
#
# Copy to `.env` and fill in real values; `.env` is gitignored and read by
# `compose.yaml` via `env_file`. See docs/installation.md "Run with Compose".
#
#   cp .env.example .env
#   # edit .env, then:  podman compose up -d   (or: docker compose up -d)

# ── Required ────────────────────────────────────────────────────────────────

# Django secret key — signs sessions/cookies. Inject a long random value and
# keep it STABLE across container recreation (changing it invalidates every
# logged-in player's session). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Superuser (server-owner / account #1) created non-interactively on first boot.
# Created only if absent, so changing the password here later has no effect —
# change it in-game instead.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ── Optional ────────────────────────────────────────────────────────────────

# Published host ports. Defaults match the documented surface; override to avoid
# collisions (e.g. when a host Evennia is already bound to 4000-4002).
TELNET_PORT=4000
WEB_PORT=4001
WEBSOCKET_PORT=4002
